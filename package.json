{
  "name": "primera-accion",
  "version": "0.1.0",
  "description": "Agente en español para comprar acciones tokenizadas en BNB Chain desde Telegram.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsx src/scripts/check.ts",
    "wallet:new": "tsx src/scripts/new-wallet.ts"
  },
  "dependencies": {
    "grammy": "^1.46.0",
    "viem": "^2.57.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
