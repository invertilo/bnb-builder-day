# Copia este archivo a .env y completa los valores. .env NUNCA se sube al repo.

# ── Telegram ────────────────────────────────────────────────────────────────
# Crea el bot con @BotFather y pega el token.
TELEGRAM_BOT_TOKEN=
# IDs de Telegram que pueden operar con la wallet del agente, separados por coma.
# Escríbele al bot y te responde con tu ID.
TELEGRAM_TRADER_IDS=

# ── IA (AgentRouter, compatible con OpenAI) ─────────────────────────────────
LLM_BASE_URL=https://agentrouter.org/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# ── Binance Web3 API ────────────────────────────────────────────────────────
# https://web3.binance.com/en/dev-portal → proyecto nuevo con Trading, Market, Wallet y Transaction.
# Sin estas claves el bot funciona en modo solo lectura (precios, análisis, preguntas).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Wallet del agente (BSC mainnet) ─────────────────────────────────────────
# Genera una wallet nueva con:  npm run wallet:new
# Usa montos chicos: necesita USDT para comprar y un poco de BNB para gas.
AGENT_PRIVATE_KEY=
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

# ── Mercado ─────────────────────────────────────────────────────────────────
# Emisores a usar: ondo, bstocks, xstocks (xStocks tiene muy poca liquidez en BSC).
ISSUERS=ondo,bstocks
# Precio de la acción en bolsa: yahoo (tiempo real, con respaldo de Binance) o binance.
STOCK_PRICE_SOURCE=yahoo

# ── Límites de seguridad ────────────────────────────────────────────────────
MAX_TRADE_USD=50
MAX_DAILY_USD=100
# 100 = 1%
MAX_SLIPPAGE_BPS=100
MAX_REFERENCE_GAP_BPS=150
MIN_TRADE_USD=1

DATA_PATH=data/state.json
